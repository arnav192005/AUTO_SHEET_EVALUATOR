# ─── Google Cloud ────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google_vision_key.json

# ─── OCR Provider ────────────────────────────────────────────────────────────
# Options: google_vision | paddle_ocr | trocr
OCR_PROVIDER=google_vision

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Used by litellm — prefix with provider, e.g. "claude-sonnet-4-20250514" or "gpt-4o"
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here          # optional fallback
GEMINI_API_KEY=your-gemini-api-key-here           # required for Gemini AI evaluation

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Options: openai | local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2                 # for local; or text-embedding-3-small for openai

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/evaluator.db

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ─── Cache Paths ─────────────────────────────────────────────────────────────
OCR_CACHE_DIR=./data/ocr_cache
UPLOAD_DIR=./data/uploads

# ─── Teachers (comma-separated IDs, no spaces) ───────────────────────────────
# These IDs are sent in the X-Teacher-Id header from the frontend
ALLOWED_TEACHER_IDS=teacher_demo

# Login accounts. The teacher account is created at startup if it doesn't exist.
# In development a demo teacher (teacher@scribscore.com / teacher123) is used
# when these are unset; in production no teacher is created until you set them.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_NAME=Teacher
# Secret for signing login tokens. If empty, one is generated and stored in
# data/.auth_secret. Set it explicitly when running more than one server.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=168

# Frontend origins allowed by CORS in production (comma-separated)
CORS_ORIGINS=

# Max size per uploaded file, in MB
MAX_UPLOAD_MB=20

# ─── API Budget Controls ─────────────────────────────────────────────────────
DAILY_VISION_API_BUDGET=500        # max Vision API calls per day
DAILY_LLM_TOKEN_BUDGET=1000000    # max LLM tokens per day

# ─── App Settings ────────────────────────────────────────────────────────────
APP_ENV=development               # development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ─── Confidence Thresholds ───────────────────────────────────────────────────
CONFIDENCE_AUTO_APPROVE=0.85      # >= this → auto-approved
CONFIDENCE_MANDATORY_REVIEW=0.65  # < this → mandatory human review
